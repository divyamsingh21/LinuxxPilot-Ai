# --- AI / Ollama ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct

# --- App ---
APP_ENV=development
LOG_LEVEL=INFO
API_HOST=127.0.0.1
API_PORT=8000

# --- Database ---
DATABASE_URL=sqlite:///./linuxpilot.db

# --- Safety ---
# Master switch. Keep this FALSE until the Command Validation Layer has
# been reviewed and you understand exactly what it allows.
ALLOW_COMMAND_EXECUTION=false
ALLOWED_SERVICES=docker,apache2,nginx,ssh,mysql,postgresql
COMMAND_TIMEOUT_SECONDS=20
